+def format_sources(sources):
+    if not sources:
+        return ""
+
+    source_html = "\n\n**Sources:**"
+
+    seen = set()
+    for url in sources:
+        if not url or url in seen:
+            continue
+
+        seen.add(url)
+
+        safe_url = html.escape(str(url), quote=True)
+
+        source_html += (
+            f'\n<div class="source-card">'
+            f'<span class="source-icon">📎</span>'
+            f'<a href="{safe_url}" target="_blank" class="source-link">{safe_url}</a>'
+            f'</div>'
+        )
+
+    return source_html
+
+
+def call_backend(question):
+    response = requests.post(
+        BACKEND_URL,
+        json={"question": question},
+        timeout=90
+    )
+
+    response.raise_for_status()
+
+    data = response.json()
+
+    answer = data.get("answer", "No answer returned.")
+    sources = data.get("sources", [])
+
+    formatted_answer = answer + format_sources(sources)
+
+    return formatted_answer
+
