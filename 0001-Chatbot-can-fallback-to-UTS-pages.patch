+    def _is_trusted_uts_url(self, url: str) -> bool:
+        """
+        Checks the actual URL domain.
+        This prevents fake/wrapper URLs that only contain 'uts.edu.au' in the text.
+        """
+        try:
+            parsed = urlparse(url)
+            domain = parsed.netloc.lower()
+
+            if not domain:
+                return False
+
+            if domain.startswith("www."):
+                domain_no_www = domain[4:]
+            else:
+                domain_no_www = domain
+
+            for trusted in self.TRUSTED_DOMAINS:
+                trusted_clean = trusted.lower()
+
+                if trusted_clean.startswith("www."):
+                    trusted_clean = trusted_clean[4:]
+
+                if (
+                    domain == trusted.lower()
+                    or domain_no_www == trusted_clean
+                    or domain_no_www.endswith("." + trusted_clean)
+                ):
+                    return True
+
+            return False
+
+        except Exception:
+            return False
